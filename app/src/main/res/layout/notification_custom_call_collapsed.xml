<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_call_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_sms_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/notif_call_avatar_text"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_notif_call_avatar"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="C"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Caller Name"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_caller_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Incoming Call"
            android:textColor="#6EE7B7"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_call_decline"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_notif_call_decline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="68dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Decline"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_call_answer"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_notif_call_accept"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="68dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Answer"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
