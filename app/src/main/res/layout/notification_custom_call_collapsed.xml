<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_call_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_call_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/notif_call_avatar_text"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_notif_call_avatar"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="C"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Caller Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_caller_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Incoming call"
            android:textColor="#BBBBBB"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_call_decline"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_notif_call_decline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="72dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Decline"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_call_answer"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_notif_call_accept"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="72dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Answer"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
